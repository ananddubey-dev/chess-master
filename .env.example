# Copy this file to .env for local development. Do not use these defaults in production.
POSTGRES_DB=kingdom_chess
POSTGRES_USER=kingdom_chess
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kingdom_chess:replace-with-a-local-development-password@localhost:5432/kingdom_chess?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
API_PORT=3000
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
